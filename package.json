{
  "name": "nostrvault",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:wasm && npm run typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:web": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src tests scripts docs README.md MEMORY/memory.md *.json *.ts *.js .github .prettierrc.json",
    "format:check": "prettier --check src tests scripts docs README.md MEMORY/memory.md *.json *.ts *.js .github .prettierrc.json",
    "test:unit": "vitest run",
    "test:web": "playwright test",
    "test:linux": "xvfb-run -a dbus-run-session -- node scripts/test-linux.mjs",
    "verify:commit": "node scripts/verify.mjs all",
    "verify:web": "node scripts/verify.mjs web",
    "verify:web-linux": "node scripts/verify.mjs web-linux",
    "verify:linux": "node scripts/verify.mjs linux",
    "verify:android": "node scripts/verify.mjs android",
    "build:wasm": "node scripts/build-wasm.mjs",
    "predev": "npm run build:wasm",
    "verify:signers": "node scripts/verify-signers.mjs",
    "test:recovery:linux": "xvfb-run -a dbus-run-session -- node scripts/test-recovery-linux.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.23.1 <23",
    "npm": ">=11.8.0 <12"
  },
  "packageManager": "npm@11.8.0"
}
